# Template file for 'hyprwire'
pkgname=hyprwire
version=0.2.1
revision=2
build_style=cmake
configure_args+=" --no-warn-unused-cli"
configure_args+=" -DCMAKE_BUILD_TYPE:STRING=Release"
configure_args+=" -DCMAKE_INSTALL_PREFIX:PATH=/usr"
hostmakedepends="
  cmake
  pkgconf
"
makedepends="
  hyprutils
  libffi-devel
  pugixml-devel
"
short_desc="Fast and consistent wire protocol for IPC"
maintainer="ShiranuiYami <shiranuiyami@voidsmiths.dev>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprwire"
changelog="https://github.com/hyprwm/hyprwire/releases"
distfiles="https://github.com/hyprwm/hyprwire/archive/refs/tags/v${version}.tar.gz"
checksum=a6370db771213fe10ebca5a2da748070a7034b09131847f973fda5d60b473c11

post_patch() {
  # Fix missing cstring include for musl
  sed -i '1i#include <cstring>' src/core/client/ClientSocket.cpp
  sed -i '1i#include <cstring>' src/core/server/ServerSocket.cpp

  # Fix C++23 append_range not available in libstdc++ 14
  # Use sed with explicit line numbers for reliable replacement

  # ClientSocket.cpp - lines 110 and 117 (after adding cstring include)
  sed -i '110s|data\.append_range(std::span<uint8_t>(buffer, sizeWritten));|data.insert(data.end(), buffer, buffer + sizeWritten);|' \
    src/core/client/ClientSocket.cpp
  sed -i '117s|data\.append_range(std::span<uint8_t>(buffer, sizeWritten));|data.insert(data.end(), buffer, buffer + sizeWritten);|' \
    src/core/client/ClientSocket.cpp

  # ServerSocket.cpp - lines around 231 and 238 (after adding cstring include)
  sed -i 's|data\.append_range(std::span<uint8_t>(buffer, sizeWritten));|data.insert(data.end(), buffer, buffer + sizeWritten);|g' \
    src/core/server/ServerSocket.cpp

  # BindProtocol.cpp - lines 68-71
  sed -i '68s|.*|    { auto __t1 = g_messageParser->encodeVarInt(protocol.length()); m_data.insert(m_data.end(), __t1.begin(), __t1.end()); }|' \
    src/core/message/messages/BindProtocol.cpp
  sed -i '69s|.*|    { m_data.insert(m_data.end(), protocol.begin(), protocol.end()); }|' \
    src/core/message/messages/BindProtocol.cpp
  sed -i '71s|.*|    { std::vector<uint8_t> __t2{HW_MESSAGE_MAGIC_TYPE_UINT, 0, 0, 0, 0}; m_data.insert(m_data.end(), __t2.begin(), __t2.end()); }|' \
    src/core/message/messages/BindProtocol.cpp

  # HandshakeBegin.cpp - line 60
  sed -i '60s|.*|    { auto __t = g_messageParser->encodeVarInt(versions.size()); m_data.insert(m_data.end(), __t.begin(), __t.end()); }|' \
    src/core/message/messages/HandshakeBegin.cpp

  # HandshakeProtocols.cpp - lines 59, 62, 63
  sed -i '59s|.*|    { auto __t = g_messageParser->encodeVarInt(protocols.size()); m_data.insert(m_data.end(), __t.begin(), __t.end()); }|' \
    src/core/message/messages/HandshakeProtocols.cpp
  sed -i '62s|.*|        { auto __t = g_messageParser->encodeVarInt(p.size()); m_data.insert(m_data.end(), __t.begin(), __t.end()); }|' \
    src/core/message/messages/HandshakeProtocols.cpp
  sed -i '63s|.*|        { m_data.insert(m_data.end(), p.begin(), p.end()); }|' \
    src/core/message/messages/HandshakeProtocols.cpp

  # FatalProtocolError.cpp - lines 61, 62
  sed -i '61s|.*|    { auto __t = g_messageParser->encodeVarInt(msg.size()); m_data.insert(m_data.end(), __t.begin(), __t.end()); }|' \
    src/core/message/messages/FatalProtocolError.cpp
  sed -i '62s|.*|    { m_data.insert(m_data.end(), msg.begin(), msg.end()); }|' \
    src/core/message/messages/FatalProtocolError.cpp

  # IWireObject.cpp - lines 104, 105, 116, 132, 133
  sed -i '104s|.*|                { auto __t = g_messageParser->encodeVarInt(std::string_view(str).size()); data.insert(data.end(), __t.begin(), __t.end()); }|' \
    src/core/wireObject/IWireObject.cpp
  sed -i '105s|.*|                { std::string_view __sv(str); data.insert(data.end(), __sv.begin(), __sv.end()); }|' \
    src/core/wireObject/IWireObject.cpp
  sed -i '116s|.*|                { auto __t = g_messageParser->encodeVarInt(arrayLen); data.insert(data.end(), __t.begin(), __t.end()); }|' \
    src/core/wireObject/IWireObject.cpp
  sed -i '132s|.*|                            { auto __t = g_messageParser->encodeVarInt(std::string_view(element).size()); data.insert(data.end(), __t.begin(), __t.end()); }|' \
    src/core/wireObject/IWireObject.cpp
  sed -i '133s|.*|                            { std::string_view __sv(element); data.insert(data.end(), __sv.begin(), __sv.end()); }|' \
    src/core/wireObject/IWireObject.cpp
}

post_install() {
  vlicense LICENSE
  # Remove problematic hyprwire-scanner.pc that causes xbps-create error
  rm -f ${DESTDIR}/usr/lib/pkgconfig/hyprwire-scanner.pc
}
