# Template file for 'hyprland'
pkgname=hyprland
version=0.53.0
revision=2
build_style=cmake
configure_args+=" --no-warn-unused-cli"
configure_args+=" -DCMAKE_BUILD_TYPE:STRING=Release"
configure_args+=" -DCMAKE_INSTALL_PREFIX:PATH=/usr"
configure_args+=" -DNO_SYSTEMD:BOOL=true"
configure_args+=" -DCMAKE_CXX_STANDARD=23"
othermakedepends="
  cmake
  cpio
  gcc
  glslang
  hyprwayland-scanner
  jq
  make
  meson
  muparser-devel
  ninja
  pkgconf
  wayland-devel
"
hostmakedepends=$othermakedepends
makedepends="
  aquamarine
  cairo-devel
  glaze
  hwids
  hyprcursor
  hyprgraphics
  hyprlang
  hyprutils
  hyprwire
  libdisplay-info-devel
  libdrm-devel
  libgbm-devel
  libglvnd-devel
  libinput-devel
  libliftoff-devel
  libseat-devel
  libxcb-devel
  libXcursor-devel
  libxkbcommon-devel
  muparser-devel
  pango-devel
  re2-devel
  tomlplusplus
  wayland-devel
  wayland-protocols
  xcb-util-errors-devel
  xcb-util-renderutil-devel
  xcb-util-wm-devel
  xorg-server-xwayland
"
short_desc="Dynamic tiling Wayland compositor that doesn't sacrifice on its looks"
maintainer="ShiranuiYami <shiranuiyami@voidsmiths.dev>"
license="BSD-3-Clause"
homepage="https://hyprland.org/"
changelog="https://github.com/hyprwm/Hyprland/releases"
distfiles="https://github.com/hyprwm/Hyprland/releases/download/v${version}/source-v${version}.tar.gz"
checksum="43ed210eca530c8d65a072936640764b38e216f7da8c86be44185bb8fe7e4f3c"

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
  configure_args+=" -DCMAKE_CXX_FLAGS=\"-lexecinfo\""
  makedepends+=" libexecinfo-devel"
  depends+=" libexecinfo"
fi

post_patch() {
  # Fix musl build - add missing cstring include
  sed -i '/#include <unistd.h>/a #include <cstring>' hyprpm/src/core/HyprlandSocket.cpp

  # Fix C++26 string concatenation issue - convert string_view to string explicitly
  sed -i '274s|getRuntimeDir() + "/" + instanceSignature + "/" + filename|getRuntimeDir() + "/" + instanceSignature + "/" + std::string(filename)|' \
    hyprctl/src/main.cpp

  # Fix C++26 #embed directive - replace with const char array using sed
  {
    echo '#pragma once'
    echo ''
    echo 'constexpr const char AUTOGENERATED_PREFIX[] = R"(# AUTOGENERATED CONFIG - DO NOT EDIT MANUALLY!'
    echo ''
    echo ')";'
    echo ''
    echo 'constexpr const char EXAMPLE_CONFIG[] = R"('
    cat example/hyprland.conf
    echo ')";'
  } > src/config/defaultConfig.hpp

  # Fix XWM.hpp ternary operator type mismatch - use static_cast
  sed -i '217s|return m_connection ? \*m_connection : nullptr;|return m_connection ? static_cast<xcb_connection_t\*>(\*m_connection) : nullptr;|' \
    src/xwayland/XWM.hpp

  # Fix C++23 insert_range not available in libstdc++ 14
  sed -i '635s#requestedModes\.insert_range(requestedModes\.end(), sortedModes | std::views::reverse);#requestedModes.insert(requestedModes.end(), std::ranges::rbegin(sortedModes), std::ranges::rend(sortedModes));#' \
    src/helpers/Monitor.cpp
}

post_install() {
  # license
  vlicense LICENSE

  # install example config
  vinstall example/hyprland.conf 644 usr/share/hyprland

  # headers
  vmkdir usr/include/hyprland
  vmkdir usr/include/hyprland/protocols
  vmkdir usr/share/pkgconfig

  cmake --build ./build --config Release --target generate-protocol-headers

  find src -type f \( -name '*.hpp' -o -name '*.h' -o -name '*.inc' \) -print0 | cpio --quiet -0dump ${DESTDIR}/usr/include/hyprland
  install -Dm0644 protocols/*.h* ${DESTDIR}/usr/include/hyprland/protocols
  vinstall build/hyprland.pc 644 usr/share/pkgconfig
}

hyprland-devel_package() {
  depends="${sourcepkg}>=${version}_${revision} ${othermakedepends} ${makedepends}"
  short_desc="Dynamic tiling Wayland compositor - development files"
  pkg_install() {
    vmove usr/include
    vmove usr/share/pkgconfig
  }
}

